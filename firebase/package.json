{
  "name": "echoes-of-aether-firebase",
  "version": "1.0.0",
  "private": true,
  "description": "Firestore Security Rules and emulator tests for Echoes of Aether (Spark tier).",
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:emulator": "firebase emulators:exec --only firestore \"node --test test/*.test.js\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase": "^13.0.0"
  }
}
