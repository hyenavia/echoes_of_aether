rules_version = '2';

// GENERATED BY tool/export_cloud_limits.dart from firestore.rules.template.
// Do not edit firebase/firestore.rules directly; edit the template and re-run
// `dart run tool/export_cloud_limits.dart`.
// safetyFactor=5.0
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function slotPath(uid, slotId) {
      return /databases/$(database)/documents/saves/$(uid)/slots/$(slotId);
    }

    function goldPerSec(rank) {
      return 193.895176 * math.pow(1.0 + 3.906677 * float(rank), 1.049734);
    }

    function expPerSec(rank) {
      return 416.303457 * math.pow(1.0 + 3.907562 * float(rank), 1.049695);
    }

    function hasExactSlotSchema(d) {
      let expected = [
        'revision',
        'savedAt',
        'schemaVersion',
        'codecVersion',
        'deviceId',
        'appVersion',
        'level',
        'gold',
        'shards',
        'highestAscensionRank',
        'lifetimeClears',
        'dailyQuestDone',
        'weeklyQuestDone',
        'eventPurchasesLifetime',
        'equipmentCount',
        'blobBytes',
        'blobSha256',
        'blob'
      ];
      return d.keys().hasOnly(expected) && d.keys().hasAll(expected);
    }

    function hasValidSlotTypesAndBounds(d) {
      return d.revision is int
          && d.revision >= 1
          && d.savedAt is timestamp
          && d.savedAt == request.time
          && d.schemaVersion is int
          && d.schemaVersion >= 8
          && d.schemaVersion <= 100
          && d.codecVersion is int
          && d.codecVersion >= 1
          && d.codecVersion <= 100
          && d.deviceId is string
          && d.deviceId.size() > 0
          && d.deviceId.size() <= 128
          && d.appVersion is string
          && d.appVersion.size() > 0
          && d.appVersion.size() <= 64
          && d.level is int
          && d.level >= 1
          && d.level <= 1000000
          && d.gold is int
          && d.gold >= 0
          && d.gold <= 1000000000000000
          && d.shards is int
          && d.shards >= 0
          && d.shards <= 1000000
          && d.highestAscensionRank is int
          && d.highestAscensionRank >= 0
          && d.highestAscensionRank <= 10000
          && d.lifetimeClears is int
          && d.lifetimeClears >= 0
          && d.lifetimeClears <= 1000000000
          && d.dailyQuestDone is int
          && d.dailyQuestDone >= 0
          && d.dailyQuestDone <= 100000
          && d.weeklyQuestDone is int
          && d.weeklyQuestDone >= 0
          && d.weeklyQuestDone <= 20000
          && d.eventPurchasesLifetime is int
          && d.eventPurchasesLifetime >= 0
          && d.eventPurchasesLifetime <= 50000
          && d.equipmentCount is int
          && d.equipmentCount >= 0
          && d.equipmentCount <= 2000
          && d.blobBytes is int
          && d.blobBytes > 0
          && d.blobBytes <= 900000
          && d.blobSha256 is string
          && d.blobSha256.size() == 64
          && d.blob is bytes
          && d.blob.size() == d.blobBytes
          && d.blob.size() <= 900000;
    }

    function isValidTransitionFromPrev(d, prev) {
      let dt = float(d.savedAt.toMillis() - prev.savedAt.toMillis()) / 1000.0;
      let effDt = dt + float(28800);
      let expDenom = float(60) * math.pow(float(prev.level), 1.8);
      return d.savedAt.toMillis() >= prev.savedAt.toMillis()
          && d.revision == prev.revision + 1
          && (resource == null || d.revision > resource.data.revision)
          && d.schemaVersion >= prev.schemaVersion
          && d.codecVersion >= prev.codecVersion
          && d.level >= prev.level
          && d.highestAscensionRank >= prev.highestAscensionRank
          && d.lifetimeClears >= prev.lifetimeClears
          && d.dailyQuestDone >= prev.dailyQuestDone
          && d.weeklyQuestDone >= prev.weeklyQuestDone
          && d.eventPurchasesLifetime >= prev.eventPurchasesLifetime
          && (d.dailyQuestDone - prev.dailyQuestDone) <= int(math.floor(dt / 86400.0)) + 2
          && (d.weeklyQuestDone - prev.weeklyQuestDone) <= int(math.floor(dt / 604800.0)) + 2
          && (d.eventPurchasesLifetime - prev.eventPurchasesLifetime) <= 2 * (int(math.floor(dt / 604800.0)) + 2)
          && (d.highestAscensionRank - prev.highestAscensionRank) <= int(math.floor(dt / float(18))) + 1
          && float(d.gold - prev.gold) <= goldPerSec(d.highestAscensionRank) * effDt * 5.0 + float(100000)
          && float(d.level - prev.level) <= (expPerSec(d.highestAscensionRank) * effDt * 5.0) / expDenom + 1.0
          && float(d.lifetimeClears - prev.lifetimeClears) <= effDt / float(2) + 1.0;
    }

    function isValidSlotWrite(uid, slot) {
      let d = request.resource.data;
      let expectedSlot = string(d.revision % 2);
      let otherSlot = string((d.revision - 1) % 2);
      return hasExactSlotSchema(d)
          && hasValidSlotTypesAndBounds(d)
          && slot == expectedSlot
          && (
            (
              d.revision == 1
              && resource == null
              && !exists(slotPath(uid, '0'))
            )
            ||
            (
              d.revision > 1
              && exists(slotPath(uid, otherSlot))
              && isValidTransitionFromPrev(d, get(slotPath(uid, otherSlot)).data)
            )
          );
    }

    match /saves/{uid}/slots/{slot} {
      allow get: if isOwner(uid) && slot in ['0', '1'];
      allow list: if isOwner(uid);
      allow create, update: if isOwner(uid) && slot in ['0', '1'] && isValidSlotWrite(uid, slot);
      allow delete: if false;
    }

    match /saves/{uid}/clock/ping {
      allow get: if isOwner(uid);
      allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['t'])
          && request.resource.data.keys().hasAll(['t'])
          && request.resource.data.t is timestamp
          && request.resource.data.t == request.time;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
